# ==========================
# 1. Python 通用编译文件
# ==========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================
# 2. 虚拟环境 (非常重要)
# ==========================
# 如果你在项目内创建了虚拟环境，一定要忽略掉，否则体积巨大
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ==========================
# 3. IDE 配置 (PyCharm 及 VSCode)
# ==========================
# PyCharm 项目配置文件夹（包含你的本地运行环境配置）
.idea/
# PyCharm 辅助文件
*.iml
.vscode/
# Jupyter Notebook 临时检查点
.ipynb_checkpoints/


# 训练产生的日志和TensorBoard文件
run/

# 数据集文件夹（通常建议只保留下载脚本，不保留源文件）
data/

# 输出结果（测试图片、预测结果等）
checkpoints/

# ==========================
# 5. 环境配置文件 (敏感信息)
# ==========================
# .env 存放密钥/API，绝对不能传
.env
*.pem
*.key
secrets.yaml

# ==========================
# 6. 包管理器和测试覆盖
# ==========================
# pip 缓存/临时文件
pip-log.txt
pip-delete-this-directory.txt

# Poetry 或 Pdm 如果使用了本地锁文件，建议保留，但某些情况下可忽略
# poetry.lock  # 通常建议保留，这里暂不屏蔽

# 测试覆盖率文件
.coverage
htmlcov/
.tox/
.pytest_cache/

# ==========================
# 7. 操作系统杂项
# ==========================
.DS_Store        # macOS 系统文件
Thumbs.db        # Windows 系统文件
*.tmp
*.swp
*.swo